{
  "name": "veyloria-online",
  "version": "0.1.0",
  "private": true,
  "description": "Veyloria Online \u2014 2D Fantasy MMORPG (Phase 1: playable single-player foundation)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "npm run build && node tests/e2e/run-e2e.mjs",
    "validate:data": "vitest run tests/unit/data.test.ts",
    "assets:manifest": "node scripts/generate-asset-manifest.mjs",
    "assets:batch001": "node tools/asset-studio/scripts/run.mjs ./tools/asset-studio/src/build-batch001.ts",
    "demo:batch001": "npm run build && node tests/e2e/batch001-demo.mjs",
    "assets:ai:generate": "node tools/asset-studio/scripts/run.mjs ./tools/asset-studio/src/ai/generate.ts",
    "assets:ai:import": "node tools/asset-studio/scripts/run.mjs ./tools/asset-studio/src/ai/import.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}